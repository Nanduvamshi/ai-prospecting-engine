# ==========================================================================
# prospecting — environment
#
# Copy to .env and fill in. Grouped by how much you actually need them.
# Nothing here has a production default: if a required value is missing the
# app fails loudly at startup rather than quietly pointing somewhere wrong.
# ==========================================================================

# ---------------------------------------------------------------- REQUIRED
# Postgres. docker-compose provides this automatically for the app service.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/prospecting

# auth | dev
#   dev    — requireAuth returns a fixed user, no network calls, no Cognito.
#            Refuses to start when NODE_ENV=production.
#   cognito — verifies real Cognito ID tokens.
AUTH_MODE=dev
# Same value, exposed to the browser so the UI knows not to expect a session.
NEXT_PUBLIC_AUTH_MODE=dev

# Shared secret for every /api/cron/* endpoint (header: x-cron-secret).
CRON_SECRET=change-me-in-production


# ------------------------------------------------------------- RECOMMENDED
# The ONE key that unlocks the core find-leads loop. Lead extraction is an
# LLM step; without a provider the pipeline stops at phase 4.
ANTHROPIC_API_KEY=

# Web search for phase 2. Without it the pipeline falls back to DuckDuckGo,
# which works without a key but returns fewer and noisier results.
SERPAPI_API_KEY=


# ----------------------------------------------------------------- OPTIONAL
# Every provider below self-skips when unset. Nothing breaks; you just get
# less enrichment. Check the startup capability log to see what is live.

# --- AI alternatives ---
AI_PRIMARY_PROVIDER=anthropic            # anthropic | openai | anthropic-bedrock (must also be registered)
OPENAI_API_KEY=
AI_BEDROCK_ENABLED=false         # true requires ambient AWS credentials
AI_BEDROCK_REGION=

# --- Auth (only when AUTH_MODE=cognito) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=

# --- Auth (only when AUTH_MODE=dev) ---
DEV_ORG_ID=dev-org
DEV_USER_ID=dev-user
DEV_USER_EMAIL=dev@localhost

# --- Billing ---
BILLING_PROVIDER=noop            # noop | http
BILLING_API_URL=                 # required when BILLING_PROVIDER=http

# --- Email egress (outreach sequences) ---
EMAIL_SENDER=log                 # log | smtp | ses
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Self-hosted search (SerpAPI replacement) ---
SEARXNG_URL=
SEARXNG_KEY=

# --- LinkedIn / anti-bot enrichment ---
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SCRAPER_ID=
BRIGHTDATA_WEB_UNLOCKER_ZONE=

# --- Self-hosted Playwright scraper pool (BrightData alternative) ---
SCRAPER_POOL_URL=
SCRAPER_POOL_KEY=

# --- Contact / company databases ---
APOLLO_API_KEY=
CRUNCHBASE_API_KEY=
GITHUB_TOKEN=

# --- Email verification ---
BOUNCER_API_KEY=
VERIFIER_FLEET_URL=
VERIFIER_FLEET_KEY=
EMAIL_VERIFIER_CANARY_PCT=
VERIFICATION_CACHE_DISABLED=

# --- Background data ingestion ---
SEC_CONTACT_EMAIL=               # SEC EDGAR requires a real contact in the User-Agent
SMTP_PROBE_DOMAIN=               # EHLO / MAIL FROM domain for SMTP mailbox probes
SEC_EXTRACTOR=
JOB_POSTINGS_INGESTION=

# --- Contact graph (cross-org shared contact intelligence) ---
CONTACT_GRAPH_ENABLED=false

# --- Public lead-finder tool ---
LEAD_FINDER_DAILY_CAP=200        # hard global cap; the route is unauthenticated
